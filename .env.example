# ---------------------------------------------------------------------------
# ResumeSetu environment configuration
# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# Every variable below is actually read by the application.
# ---------------------------------------------------------------------------

# --- REQUIRED IN PRODUCTION -------------------------------------------------

# HMAC key used to sign session cookies. Admin authorization is derived from
# this signature, so it must be a long random string. The server refuses to
# start in production without it. Minimum 16 characters.
SESSION_SECRET=

# AES-256-GCM key for the encrypted resume vault. Resumes are written to
# uploads/ as ciphertext and are unrecoverable without this value, so losing it
# means losing every stored document. The server refuses to start in production
# without it.
STORAGE_ENCRYPTION_KEY=

# --- AI PROVIDERS -----------------------------------------------------------
# The orchestrator tries each available provider in order and falls back to the
# next one on failure, then to a clearly-labelled local scaffold. Only the
# providers whose key is set are attempted.

# Google Gemini - primary for the 'tailor' task (deep reasoning).
GEMINI_API_KEY=""

# Groq - primary for the cheap 'score' task (sub-second extraction).
GROQ_API_KEY=""
GROQ_MODEL="

# Anthropic - optional fallback.
ANTHROPIC_API_KEY=""
ANTHROPIC_API_VERSION=
# Overrides the default model ids used for this provider.
TAILOR_MODEL_ANTHROPIC=
SCORE_MODEL_ANTHROPIC=

# OpenAI or any OpenAI-compatible endpoint - optional fallback.
OPENAI_API_KEY=""
OPENAI_BASE_URL=

# --- MODEL ROUTING ----------------------------------------------------------
# Optional. Pins one provider to the front of the fallback chain; it does NOT
# remove the others. Leave blank to use the default per-task ordering.
AI_PROVIDER=""

# Gemini model ids.
SCORE_MODEL=
TAILOR_MODEL=

# --- SERVER -----------------------------------------------------------------
PORT=3000
NODE_ENV=

# Absolute base URL of this deployment. Used for self-referential links.
APP_URL="https://resumesetu.netlify.app"

# --- CLERK AUTHENTICATION (REQUIRED) ---------------------------------------
# Authentication is entirely Clerk: email one-time code, email + password, and
# any connected social provider are all handled by Clerk's own components. There
# is no first-party credential endpoint and the database stores no password hash.
#
# To change what users can sign in with, change it here:
#   Clerk Dashboard -> User & Authentication -> Settings          (email, password)
#   Clerk Dashboard -> User & Authentication -> Social Connections (Google, …)
# No code change is needed; the sign-in dialog renders whatever is enabled.
#
# Get these from Clerk Dashboard -> API keys. The publishable key is exposed to
# the browser; the secret key must remain server-side.
CLERK_SECRET_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""
# Comma-separated exact origins allowed to mint session tokens, e.g. production
# origin plus localhost when developing against the same Clerk instance.
CLERK_AUTHORIZED_PARTIES=""

# --- "CONTINUE WITH GOOGLE" -------------------------------------------------
# Clerk renders its own social buttons, so adding a provider needs no code
# change here. On the Clerk Dashboard:
#
#   User & Authentication -> Social Connections -> Add -> Google -> enable
#
# Clerk can use Google's default credentials for a quick test, or you can supply
# your own OAuth client ID/secret. Until it is connected the button does not
# appear at all, because Clerk only renders providers that are enabled.
#
# NOTE: the CSP derives the Clerk instance origin from VITE_CLERK_PUBLISHABLE_KEY
# (lib/csp.ts). Do not hard-code the instance host anywhere — a policy that
# omits it blocks clerk-js and breaks every sign-in in production.

# --- SUPABASE POSTGRES + STORAGE ---------------------------------------------
# Project URL and server-only Secret key (sb_secret_...) from Supabase ->
# Project Settings -> API Keys. Do not use the publishable key here or expose
# this secret through a VITE_ variable.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=
# Public keys are safe in browser builds. VITE_ names are used by this Vite app;
# NEXT_PUBLIC_ names are included only for shared tooling/Next.js compatibility.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy URL alias is accepted if SUPABASE_URL is unset.
SUPABASE_STORAGE_URL=""

# Optional direct Postgres connection string for Prisma tooling. Prefer the
# Supabase pooler URL for serverless deployments and direct URL for migrations.
DATABASE_URL=""

# Optional cloud storage compatibility placeholders (not currently used).
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
R2_BUCKET=""
R2_ACCOUNT_ID=""

# --- PAYMENTS / OWNER PROFILE ----------------------------------------------
# NOTE: no payment-provider integration is present. Pro activation is manual:
# the app builds a Telegram deep link on the server that already contains the
# payer's identity plus an HMAC-signed verification code, and the admin
# activates the account once the payment is confirmed in Telegram.
#
# Everything below is server-only. None of it is exposed to the browser except
# through GET /api/payments/config, which returns only display fields. This is
# what stops a user editing the client bundle to redirect a payment to another
# account or to somebody else's Telegram.
#
# Telegram username that receives upgrade requests (no leading @).
# Validated against Telegram's rules; an invalid value falls back to the
# built-in default and logs an error rather than linking a stranger.
OWNER_TELEGRAM=""

# Display name shown next to the payment request.
OWNER_DISPLAY_NAME=""

# Short role line, e.g. "Founder, ResumeSetu".
OWNER_ROLE=""

# Expected response time shown in the paywall, e.g. "Usually within 2 hours".
OWNER_RESPONSE_TIME=""

# Optional profile photo. Accepts an absolute https:// URL or a root-relative
# path. javascript: and data: URLs are rejected. Leave blank and the UI renders
# a branded initials avatar — a stock portrait is never substituted, because
# putting a stranger's face next to a payment request would be misleading.
OWNER_AVATAR_URL=""

# Price quoted in the activation message. The server value wins; the browser has
# its own copy in src/config.ts purely for display.
PRO_PRICE_INR="249"

# Razorpay keys are placeholders reserved for a future provider integration.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_ID=""
